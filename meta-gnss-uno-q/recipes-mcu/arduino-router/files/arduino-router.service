[Unit]
Description=Arduino router: RPC link to the STM32 microcontroller
Documentation=https://github.com/arduino/arduino-router
After=network.target

# Upstream ships a generic unit plus a board-specific drop-in selected at boot
# by a generator (debian/arduino-router/.../10-imola.conf in v0.11.0). This
# image only runs on the UNO Q, so both are merged here.
#
# PENDING HARDWARE TEST: the GPIO chip and line numbers below are the ones
# upstream uses with the factory kernel. Confirm them on this image with
# `gpiodetect` / `gpioinfo` (docs/board-access.md) before relying on them.

[Service]
Type=simple
# Put the microcontroller in a ready state.
ExecStartPre=-/usr/bin/gpioset -c /dev/gpiochip1 -t0 37=0
# /dev/ttyHS1 is the UART wired to the STM32 (device tree alias serial1).
# Once the router is listening, line 70 goes high: the MCU loader, which waits
# for Linux by default, then leaves the boot animation and starts the sketch.
ExecStart=/usr/bin/arduino-router --unix-port /var/run/arduino-router.sock --serial-port /dev/ttyHS1 --serial-baudrate 115200 --after-ready '/usr/bin/gpioset -c /dev/gpiochip1 -t0 70=1'
# When the router stops: back to the boot animation and reset the MCU.
ExecStopPost=-/usr/bin/gpioset -c /dev/gpiochip1 -t0 70=0
ExecStopPost=-/usr/bin/gpioset -c /dev/gpiochip1 -t0 38=0
ExecStopPost=-/usr/bin/gpioset -c /dev/gpiochip1 -t0 38=1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
